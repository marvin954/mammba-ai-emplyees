# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexusos:nexusos_dev_password@localhost:5432/nexusos
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change_this_to_a_32_char_random_string_in_production
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─��─ AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OLLAMA_BASE_URL=http://localhost:11434

# ─── Stripe (Platform Billing) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─��─ Email (via Mailpit in dev) ───────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@nexusos.local

# ─── Object Storage (S3-compatible) ───────────────────────────────────────────
S3_BUCKET=nexusos-uploads
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# ─── n8n Automation ───────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_SECRET=change_this_webhook_secret

# ──��� RapidAPI ─────────────────────────────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32 (must be 64 hex chars = 32 bytes)
ENCRYPTION_KEY=change_this_64_char_hex_string_for_credential_encryption

# ─── Workers ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
PORT=4000
